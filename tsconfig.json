{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["jest"]
  },
  "exclude": ["node_modules", "fixture", "sdk", ".tsbuild"],
  "references": [{ "path": "./sdk" }]
}
